# RedactX Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/redactx

# CORS Configuration (comma-separated list of allowed origins)
# For production, use the actual domain, e.g., https://redactx.example.com
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration
# This variable is used by the frontend build to locate the backend API
VITE_API_URL=http://localhost:3000
